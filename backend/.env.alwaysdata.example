# ==============================================================================
# Alwaysdata Configuration & Deployment
# ==============================================================================

# Your Alwaysdata account name (found at top left in https://admin.alwaysdata.com)
ALWAYSDATA_ACCOUNT=

# Alwaysdata API Key (get from: https://admin.alwaysdata.com -> Remote access -> API keys)
ALWAYSDATA_API_KEY=

# Alwaysdata Site ID (get from: https://admin.alwaysdata.com -> Web -> Sites)
ALWAYSDATA_SITE_ID=

# SSH Host (default: ssh-[ALWAYSDATA_ACCOUNT].alwaysdata.net)
ALWAYSDATA_SSH_HOST=

# SSH User (default is same as ALWAYSDATA_ACCOUNT)
ALWAYSDATA_SSH_USER=

# Remote application directory on Alwaysdata (default: /home/[account]/superapp_backend)
ALWAYSDATA_REMOTE_DIR=superapp_backend

# ==============================================================================
# Application Database & Runtime Configuration (deployed to Alwaysdata)
# ==============================================================================
PORT=8100
DB_HOST=postgresql-[ALWAYSDATA_ACCOUNT].alwaysdata.net
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=
DB_SSL=false
DB_SYNCHRONIZE=true
MINIAPP_STORAGE_DIR=/home/[ALWAYSDATA_ACCOUNT]/superapp_backend/storage/miniapps
