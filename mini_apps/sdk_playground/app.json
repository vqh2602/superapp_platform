{
  "manifestVersion": 1,
  "appId": "sdk_playground",
  "name": "SDK Playground",
  "description": "React + TypeScript Mini App test bed with interactive SDK runner",
  "category": "Developer Tools",
  "version": "1.0.0",
  "runtimeType": "web",
  "entry": "dist/index.html",
  "icon": "icon.png",
  "permissions": [
    "auth.requestCode",
    "user.getProfile",
    "user.getBasicInfo",
    "navigation.openNativePage",
    "navigation.close",
    "navigation.openMiniApp",
    "device.scanQRCode",
    "device.getLocation",
    "device.pickImage",
    "permission.request",
    "permission.getPermissions",
    "storage.setSecureItem",
    "storage.getSecureItem",
    "storage.removeSecureItem",
    "storage.clear",
    "storage.setCredentials",
    "storage.getCredentials",
    "storage.deleteCredentials",
    "storage.secure",
    "contacts",
    "device.scanQr",
    "scanQr",
    "device.scanBarcode",
    "scanBarcode",
    "getPhoto",
    "pickImages",
    "saveImageToGallery",
    "pickVideo",
    "saveVideoToGallery",
    "saveFile",
    "pickFile",
    "filePreview",
    "showToast",
    "vibrate",
    "copyToClipboard",
    "setBrightness",
    "setStatusBarStyle",
    "setStatusBarColor",
    "setNavigationBarColor",
    "configAppView",
    "showMiniappMenu",
    "closeApp",
    "getNetworkInfo",
    "getDeviceLanguage",
    "getSuperAppSettings",
    "getSystemInfo",
    "getAppInfo",
    "getBatteryInfo",
    "getContacts",
    "setSecretData",
    "getSecretData",
    "removeSecretData",
    "microphone",
    "openPhone",
    "openSMS",
    "openExternalBrowser",
    "openDeepLink",
    "speechToText",
    "hideKeyboard",
    "debug.echo",
    "debug.simulateFailure"
  ],
  "developerName": "SuperApp Platform Team",
  "supportEmail": "developer@superapp.vn",
  "website": "https://superapp.vn",
  "themeColor": "#0068FF"
}
