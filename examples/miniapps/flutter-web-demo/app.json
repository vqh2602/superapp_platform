{
  "manifestVersion": 1,
  "appId": "flutter_web_demo",
  "name": "Flutter Web Mini App",
  "description": "Mini App mẫu phát triển bằng Flutter Web chạy trong SuperApp",
  "category": "Demo",
  "version": "1.0.0",
  "runtimeType": "web",
  "entry": "dist/index.html",
  "icon": "icon.png",
  "permissions": [
    "navigation.close",
    "user.getProfile",
    "device.getBatteryInfo",
    "device.scanQRCode",
    "payment.createOrder"
  ],
  "developerName": "Flutter Team",
  "supportEmail": "flutter@example.com",
  "website": "https://flutter.dev",
  "themeColor": "#02569B"
}
