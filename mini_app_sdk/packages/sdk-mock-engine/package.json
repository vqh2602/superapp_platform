{
  "name": "@superapp/sdk-mock-engine",
  "version": "1.0.0",
  "description": "Mock Engine for SuperApp Mini Apps: Auth, Token, Payment, Device, and Storage Simulation",
  "type": "module",
  "main": "./dist/index.js",
