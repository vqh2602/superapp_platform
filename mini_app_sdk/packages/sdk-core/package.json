{
  "name": "@superapp/mini-app-sdk",
  "version": "1.0.0",
  "description": "Official TypeScript SDK for SuperApp Mini App Third-Party Developers",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@superapp/sdk-transport": "*",
    "@superapp/sdk-mock-engine": "*"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "superapp",
    "mini-app",
    "sdk",
    "typescript",
    "api"
  ],
  "author": "SuperApp Platform Team",
  "license": "MIT"
}
